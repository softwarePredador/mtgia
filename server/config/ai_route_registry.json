      "provider_calls": [
        {
          "name": "tentativa primária do otimizador",
          "callsite": "server/lib/ai/otimizacao.dart",
          "ai_logs_endpoint": "provider:optimize",
          "when": "com chave, no modo optimize, quando não há shortlist determinística",
          "on_failure": "422 com quality_error OPTIMIZE_EXECUTION_FAILED quando o deck está saudável, senão 500 \"Optimization failed\"; o deck fica como estava"
