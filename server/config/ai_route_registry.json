    "api.openai.com",
    "OpenAiRuntimeConfig"
  ],
  "vocabulary": {
    "status": [
      "guarded_off",
      "legacy_off"
    ],
    "status_meaning": {
      "guarded_off": "tem consumidor; a capability fica desligada até as tarefas do dono fecharem",
      "legacy_off": "sem consumidor de produto; fica desligada sob legacy_ai_routes com veredito e substituto"
    },
    "lane": [
      "deck_e_ia",
      "battle"
    ],
    "access_policy": [
      "meteredAction",
      "rateLimitedAuxiliary",
      "polling",
      "authOnly"
    ]
  },
  "rule": "D-31: rota sem consumidor no app, no site e nos scripts, e com substituto, sai junto com os testes que a tratam como recurso. Uma rota nova de IA entra aqui antes de ganhar capability.",
  "providers": {
    "openai_chat_completions": {
      "url": "https://api.openai.com/v1/chat/completions",
      "url_configurable": false,
      "key_env": "OPENAI_API_KEY",
      "callsites": [
        "server/lib/ai/commander_ai_live_eval_support.dart",
        "server/lib/ai/optimization_validator.dart",
        "server/lib/ai/otimizacao.dart",
        "server/routes/ai/archetypes/index.dart",
        "server/routes/ai/explain/index.dart",
        "server/routes/ai/generate/index.dart",
        "server/routes/decks/[id]/ai-analysis/index.dart"
      ],
      "callsite_occurrences": {
        "server/lib/ai/commander_ai_live_eval_support.dart": 1,
        "server/lib/ai/optimization_validator.dart": 1,
        "server/lib/ai/otimizacao.dart": 2,
        "server/routes/ai/archetypes/index.dart": 1,
        "server/routes/ai/explain/index.dart": 1,
        "server/routes/ai/generate/index.dart": 1,
        "server/routes/decks/[id]/ai-analysis/index.dart": 1
      },
      "note": "A URL está fixa no código: 8 pontos em 7 arquivos. Antes da D-31 eram 9 em 8; a sessão do gate achou os 4 de server/lib, e deck_recommendations_route_support.dart saiu com a D-31. A fixture isolada (scripts/manaloom_server_contract_e2e_isolated.sh) exporta OPENAI_BASE_URL vazia, mas nenhum código do servidor (lib e routes) lê essa variável; só o entrypoint do laboratório Hermes (server/bin/hermes_lab_entrypoint.sh) a usa, para o próprio Hermes. Trocar o provedor por base URL exige mexer nos 7 arquivos. commander_ai_live_eval_support.dart é da avaliação ao vivo, fora das rotas.",
      "without_key": "Perfil de produção: 503 nas rotas que dependem do provedor. Fora da produção: mock ou fallback local marcado is_mock=true, nunca cacheado nem aplicável; o POST /ai/optimize entrega as trocas determinísticas quando há shortlist (D-82)."
    },
    "edhrec": {
      "url": "https://json.edhrec.com",
      "url_configurable": false,
      "key_env": null,
      "switch_env": "MANALOOM_EDHREC_AUTOMATED_COLLECTION_AUTHORIZED",
      "note": "fonte de dados, não é provedor de IA; a coleta automática fica desligada por padrão",
      "without_key": "com a coleta desligada, nenhuma chamada sai e a validação por EDHREC é pulada"
    },
    "battle_sidecars": {
      "url": "XMAGE_SIDECAR_URL, FORGE_SIDECAR_URL, NATIVE_BATTLE_SIDECAR_URL, XMAGE_INTERACTIVE_SIDECAR_URL",
      "url_configurable": true,
      "key_env": null,
      "note": "motores de regra (XMage, Forge, nativo) em processos próprios; não são provedor de IA",
      "without_key": "sem URL configurada o motor falha fechado com 503 e código estável"
    },
    "mtgtop8": {
      "url": "https://www.mtgtop8.com",
