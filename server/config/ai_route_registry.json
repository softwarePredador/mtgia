  "description": "Registry de todas as rotas de IA do servidor: consumidor, escritas, capability, dono, substituto, provedor externo, URL do provedor e o que acontece sem ele. server/test/ai_route_registry_test.dart falha quando surge rota de IA fora dele.",
  "scope_rule": "Rota de IA é toda rota sob /ai, toda rota que requiredCapabilityForRequest põe numa capability de ai_capabilities e todo handler que fala com o provedor direto (provider_markers).",
  "ai_capabilities": [
    "ai_analyze_optimize_advisory",
    "ai_generate_rebuild",
    "legacy_ai_routes",
    "learning_reads",
    "learning_writes",
    "battle_batch",
    "battle_live",
    "battle_coach"
  ],
