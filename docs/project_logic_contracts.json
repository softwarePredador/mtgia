  "receipt_contracts": [
    {
      "id": "project_logic_manifest_v1",
      "flows": ["release_operations"],
      "producers": ["scripts/manaloom_project_logic.sh"],
      "consumers": ["scripts/manaloom_local_ci.sh", ".githooks/pre-commit", ".githooks/pre-push"],
      "durability": "tracked_generated",
      "allowed_statuses": ["pass", "drift"],
      "required_bindings": ["source_digest_sha256", "lineage.digest_inputs", "generator.version"]
    },
    {
      "id": "deck_ai_learning_gate_v2",
      "flows": ["deck_ai"],
      "producers": ["scripts/manaloom_deck_ai_learning_gate.sh", "scripts/manaloom_deck_ai_learning_release_receipt.sh"],
      "consumers": ["scripts/quality_gate.sh", "scripts/manaloom_local_ci.sh"],
      "schemas": ["manaloom.deck_ai_learning_gate_run.v2", "manaloom.deck_ai_learning_release_receipt.v2"],
      "durability": "ephemeral_until_reviewed_and_tracked",
      "allowed_statuses": ["PASS_CODE_ONLY", "PASS", "BLOCKED", "FAIL"],
      "required_bindings": ["policy.id", "profile", "git_sha", "worktree_digest_sha256", "project_logic_source_digest", "source.start", "source.end", "source.stable", "target.identity_sha256", "target.schema", "checks", "evidence.artifact_manifest_sha256", "release_eligible"]
    },
    {
      "id": "manaloom_e2e_suite_v1",
      "flows": ["release_operations"],
      "producers": ["scripts/manaloom_e2e_suite.sh"],
      "consumers": ["scripts/quality_gate.sh", "scripts/manaloom_local_ci.sh"],
      "durability": "ephemeral_until_reviewed_and_tracked",
      "allowed_statuses": ["PASS", "PARTIAL", "BLOCKED", "FAIL"],
      "required_bindings": ["requested_profile", "execution_policy", "result", "gate_eligible", "summary.step_count", "summary.skipped", "steps"],
      "status_semantics": {
        "PASS": {"strict_exit_code": 0, "gate_eligible": true},
        "PARTIAL": {"strict_exit_code": 3, "diagnostic_gate_eligible": false},
        "BLOCKED": {"strict_exit_code": 2, "gate_eligible": false},
        "FAIL": {"strict_exit_code": 1, "gate_eligible": false}
      }
    },
    {
      "id": "ui_live_evidence_v1",
      "flows": ["release_operations"],
      "producers": ["scripts/manaloom_ui_live_evidence_gate.sh"],
      "consumers": ["scripts/quality_gate.sh", "scripts/manaloom_local_ci.sh"],
      "durability": "reviewed_tracked_evidence",
      "allowed_statuses": ["PASS_AUTOMATED", "PASS_RUNTIME", "PASS_VISUAL_REVIEWED", "BLOCKED", "FAIL"],
      "required_bindings": ["ui_source_digest", "runtime_target", "screenshot_paths", "screenshot_sha256", "reviewed_all"]
    },
    {
      "id": "release_identity_v1",
      "flows": ["release_operations"],
      "producers": ["scripts/manaloom_release_identity.sh"],
      "consumers": ["scripts/manaloom_local_ci.sh", "scripts/manaloom_release_ops_contract_test.sh"],
      "durability": "release_artifact",
      "allowed_statuses": ["candidate", "deployed", "blocked"],
      "required_bindings": ["git_sha", "artifact_digests", "capability_matrix", "schema_range", "surface"]
    }
  ],
