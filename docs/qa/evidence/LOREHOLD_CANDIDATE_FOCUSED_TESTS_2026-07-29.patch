@@ -0,0 +1,35 @@
+package org.mage.test.game;
+
+import mage.constants.PhaseStep;
+import mage.game.match.MatchOptions;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class MatchOptionsRuntimeBoundaryTest {
+
+    @Test
+    public void storesRuntimeStopBoundary() {
+        MatchOptions options = new MatchOptions(
+                "bounded simulation",
+                "test match name",
+                false
+        );
+
+        options.setStopOnTurn(11);
+        options.setStopAtStep(PhaseStep.UNTAP);
+
+        Assert.assertEquals(Integer.valueOf(11), options.getStopOnTurn());
+        Assert.assertEquals(PhaseStep.UNTAP, options.getStopAtStep());
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void rejectsNonPositiveRuntimeStopBoundary() {
+        MatchOptions options = new MatchOptions(
+                "invalid bounded simulation",
+                "test match name",
+                false
+        );
+
+        options.setStopOnTurn(0);
+    }
+}
