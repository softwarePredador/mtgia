+    @Test
+    public void mandateOfPeaceQuarantineReproducesResidualOriginalSpellAfterConcurrentRemoval() {
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears");
+        addCard(Zone.BATTLEFIELD, playerA, "Walking Ballista");
+        addCard(Zone.BATTLEFIELD, playerA, "Glorious Anthem");
+        addCounters(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Walking Ballista", CounterType.P1P1, 2);
+        addCard(Zone.HAND, playerA, "Lightning Bolt");
+        addCard(Zone.HAND, playerA, "Fork");
+        addCard(Zone.HAND, playerA, MANDATE_OF_PEACE);
+        addCard(Zone.HAND, playerB, "Opt");
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 2);
+        addCard(Zone.BATTLEFIELD, playerB, "Island");
+
+        attack(1, playerA, "Grizzly Bears");
+        castSpell(1, PhaseStep.DECLARE_ATTACKERS, playerA, "Lightning Bolt", playerB);
+        castSpell(
+                1, PhaseStep.DECLARE_ATTACKERS, playerA,
+                "Fork", "Lightning Bolt", "Lightning Bolt", StackClause.WHILE_ON_STACK
+        );
+        setChoice(playerA, false);
+        waitStackResolved(1, PhaseStep.DECLARE_ATTACKERS, 1);
+        activateAbility(
+                1, PhaseStep.DECLARE_ATTACKERS, playerA,
+                "Remove a +1/+1 counter", "Grizzly Bears",
+                "Lightning Bolt", StackClause.WHILE_COPY_ON_STACK
+        );
+        activateAbility(
+                1, PhaseStep.DECLARE_ATTACKERS, playerA,
+                "Remove a +1/+1 counter", "Grizzly Bears",
+                "Remove a +1/+1 counter", StackClause.WHILE_ON_STACK
+        );
+        castSpell(
+                1, PhaseStep.DECLARE_ATTACKERS, playerA,
+                MANDATE_OF_PEACE, TestPlayer.NO_TARGET,
+                "Remove a +1/+1 counter", StackClause.WHILE_ON_STACK
+        );
+        checkPlayableAbility(
+                "Mandate must prevent the opponent from casting after combat",
+                1, PhaseStep.POSTCOMBAT_MAIN, playerB,
+                "Cast Opt", false
+        );
+        checkStackSize(
+                "Mandate must leave no original, copy, or activated ability on the stack",
+                1, PhaseStep.POSTCOMBAT_MAIN, playerA, 0
+        );
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        // Quarantine evidence for TODO #12911: one original Bolt incorrectly survives and resolves.
+        assertLife(playerB, 17);
+        assertGraveyardCount(playerA, "Lightning Bolt", 1);
+        assertExileCount(playerA, "Lightning Bolt", 0);
+        assertGraveyardCount(playerA, "Fork", 1);
+        assertExileCount(playerA, MANDATE_OF_PEACE, 1);
+        assertDamageReceived(playerA, "Grizzly Bears", 0);
+        assertHandCount(playerB, "Opt", 1);
+    }
