+    @Test
+    public void haktosProtectionReadsTheChosenNumberFromItsSourceZcc() {
+        skipInitShuffling();
+        addCard(Zone.HAND, playerA, HAKTOS);
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 2);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 2);
+
+        runCode(
+                "seed Haktos choice",
+                1, PhaseStep.PRECOMBAT_MAIN, playerA,
+                (info, player, game) -> RandomUtil.setSeed(1)
+        );
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, HAKTOS);
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+        runCode(
+                "verify chosen-number protection",
+                1, PhaseStep.PRECOMBAT_MAIN, playerA,
+                (info, player, game) -> {
+                    Permanent haktos = getPermanent(HAKTOS, playerA);
+                    ProtectionAbility protection = getHaktosProtection(haktos, game);
+                    int chosen = getHaktosChosenNumber(haktos, protection, game);
+
+                    for (String candidate : new String[]{"Grizzly Bears", "Centaur Courser", "Hill Giant"}) {
+                        Card card = createCard(candidate, playerB);
+                        boolean canTarget = protection.canTarget(card, game);
+                        Assert.assertEquals(
+                                info + " — protection must apply to every mana value except " + chosen
+                                        + " for " + candidate,
+                                card.getManaValue() == chosen,
+                                canTarget
+                        );
+                    }
+                }
+        );
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+    }
