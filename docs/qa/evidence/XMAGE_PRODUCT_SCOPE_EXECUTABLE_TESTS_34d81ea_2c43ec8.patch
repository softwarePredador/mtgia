+    private void initPlayerALibrary() {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        addCard(Zone.LIBRARY, playerA, CARD_D);
+        addCard(Zone.LIBRARY, playerA, CARD_C);
+        addCard(Zone.LIBRARY, playerA, CARD_B);
+        addCard(Zone.LIBRARY, playerA, CARD_A);
+    }
+
+    private static ProtectionAbility getHaktosProtection(Permanent haktos, Game game) {
+        List<ProtectionAbility> abilities = haktos.getAbilities(game).getProtectionAbilities();
+        Assert.assertEquals("Haktos must have exactly one granted protection ability", 1, abilities.size());
+        return abilities.get(0);
+    }
+
+    private static int getHaktosChosenNumber(Permanent haktos, ProtectionAbility protection, Game game) {
+        String key = haktos.getId() + "_" + protection.getStackMomentSourceZCC() + "_haktos_number";
+        Object value = game.getState().getValue(key);
+        Assert.assertTrue("Haktos chosen-number state must exist at key " + key, value instanceof Integer);
+        int number = (Integer) value;
+        Assert.assertTrue("Haktos chosen number must be 2, 3, or 4", number >= 2 && number <= 4);
+        return number;
+    }
+
+    private static Card createCard(String name, TestPlayer owner) {
+        Card card = CardRepository.instance.findCard(name).createCard();
+        card.setOwnerId(owner.getId());
+        return card;
+    }
