+    @Test
+    public void haktosZoneChangeUsesFreshZccStateInsteadOfStaleChoice() {
+        AtomicInteger firstZcc = new AtomicInteger();
+        AtomicInteger firstChoice = new AtomicInteger();
+
+        skipInitShuffling();
+        addCard(Zone.HAND, playerA, HAKTOS);
+        addCard(Zone.HAND, playerA, "Ghostway");
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 2);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 5);
+
+        runCode(
+                "seed two different Haktos choices",
+                1, PhaseStep.PRECOMBAT_MAIN, playerA,
+                (info, player, game) -> RandomUtil.setSeed(1)
+        );
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, HAKTOS);
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+        runCode(
+                "capture first Haktos state",
+                1, PhaseStep.PRECOMBAT_MAIN, playerA,
+                (info, player, game) -> {
+                    Permanent haktos = getPermanent(HAKTOS, playerA);
+                    ProtectionAbility protection = getHaktosProtection(haktos, game);
+                    firstZcc.set(haktos.getZoneChangeCounter(game));
+                    firstChoice.set(getHaktosChosenNumber(haktos, protection, game));
+                }
+        );
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Ghostway");
+        runCode(
+                "verify fresh Haktos state",
+                2, PhaseStep.UPKEEP, playerA,
+                (info, player, game) -> {
+                    Permanent haktos = getPermanent(HAKTOS, playerA);
+                    ProtectionAbility protection = getHaktosProtection(haktos, game);
+                    int secondZcc = haktos.getZoneChangeCounter(game);
+                    int secondChoice = getHaktosChosenNumber(haktos, protection, game);
+
+                    Assert.assertNotEquals(info + " — zone change must advance source ZCC", firstZcc.get(), secondZcc);
+                    Assert.assertNotEquals(
+                            info + " — deterministic seed must expose stale-state reads",
+                            firstChoice.get(), secondChoice
+                    );
+
+                    Card oldMatch = createCard(
+                            firstChoice.get() == 2 ? "Grizzly Bears"
+                                    : firstChoice.get() == 3 ? "Centaur Courser" : "Hill Giant",
+                            playerB
+                    );
+                    Assert.assertFalse(
+                            info + " — old chosen value must now be protected against",
+                            protection.canTarget(oldMatch, game)
+                    );
+                }
+        );
+
+        setStrictChooseMode(true);
+        setStopAt(2, PhaseStep.PRECOMBAT_MAIN);
+        execute();
+    }
