+package org.mage.test.cards.single.manaloom;
+
+import mage.abilities.keyword.MenaceAbility;
+import mage.abilities.keyword.VigilanceAbility;
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import mage.counters.CounterType;
+import org.junit.Test;
+import org.mage.test.player.TestPlayer;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * Focused rules coverage for the Marvel cards promoted to ManaLoom's
+ * product-in-scope catalog.
+ */
+public class ManaLoomProductInScopeMarvelCardsTest extends CardTestPlayerBase {
+
+    private static final String ALICIA = "Alicia Masters, Skilled Sculptor";
+    private static final String HYDRA = "HYDRA Troopers";
+    private static final String NICK = "Nick Fury, Agent of S.H.I.E.L.D.";
+    private static final String ORIGIN = "Origin of the Avengers";
+    private static final String PHOTON = "Photon Blast Barrage";
+    private static final String SPDR = "SP//dr, Piloted by Peni";
+
+    private static final String CARD_A = "Alaborn Trooper";
+    private static final String CARD_B = "Barbtooth Wurm";
+    private static final String CARD_C = "Canopy Gorger";
+    private static final String CARD_D = "Devilthorn Fox";
+
+    private void prepareFourCardLibrary() {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        // Bottom D C B A Top.
+        addCard(Zone.LIBRARY, playerA, CARD_D);
+        addCard(Zone.LIBRARY, playerA, CARD_C);
+        addCard(Zone.LIBRARY, playerA, CARD_B);
+        addCard(Zone.LIBRARY, playerA, CARD_A);
+    }
+
+    private void prepareNickMana() {
+        addCard(Zone.BATTLEFIELD, playerA, "Plains");
+        addCard(Zone.BATTLEFIELD, playerA, "Island");
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp");
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain");
+        addCard(Zone.BATTLEFIELD, playerA, "Forest");
+    }
+
+    private void prepareNickLibrary(String eligibleCard) {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        // This eighth card must stay above the six rejected cards after the
+        // selected card leaves the top seven.
+        addCard(Zone.LIBRARY, playerA, "Lightning Bolt");
+        addCard(Zone.LIBRARY, playerA, "Healing Salve");
+        addCard(Zone.LIBRARY, playerA, "Unsummon");
+        addCard(Zone.LIBRARY, playerA, "Dark Ritual");
+        addCard(Zone.LIBRARY, playerA, "Giant Growth");
+        addCard(Zone.LIBRARY, playerA, "Shock");
+        addCard(Zone.LIBRARY, playerA, "Disenchant");
+        addCard(Zone.LIBRARY, playerA, eligibleCard);
+    }
+
+    @Test
+    public void testAliciaTreasureRequiresNoncreatureSpellThisTurn() {
+        addCard(Zone.BATTLEFIELD, playerA, ALICIA);
+        addCard(Zone.HAND, playerA, "Memnite");
+        addCard(Zone.HAND, playerA, "Accorder's Shield");
+
+        // A creature spell must not satisfy the intervening-if condition.
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Memnite");
+        // The watcher must reset between turns; this noncreature spell is the
+        // only event that may make a Treasure.
+        castSpell(3, PhaseStep.PRECOMBAT_MAIN, playerA, "Accorder's Shield");
+
+        setStrictChooseMode(true);
+        setStopAt(3, PhaseStep.POSTCOMBAT_MAIN);
+        execute();
+
+        assertPermanentCount(playerA, "Treasure Token", 1);
+        assertPermanentCount(playerA, "Memnite", 1);
+        assertPermanentCount(playerA, "Accorder's Shield", 1);
+    }
+
+    @Test
+    public void testAliciaReturnsOwnedCreaturesDuringEndStep() {
+        addCard(Zone.BATTLEFIELD, playerA, ALICIA);
+        addCard(Zone.BATTLEFIELD, playerB, "Silvercoat Lion");
+        addCard(Zone.HAND, playerA, "Act of Treason");
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 3);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Act of Treason", "Silvercoat Lion");
+
+        // Stop in the end step, before Act of Treason expires in cleanup, so
+        // only Alicia can have returned the creature to its owner.
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertPermanentCount(playerA, "Silvercoat Lion", 0);
+        assertPermanentCount(playerB, "Silvercoat Lion", 1);
+    }
+
+    @Test
+    public void testHydraTroopersMillsBelowCreatureThreshold() {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        addCard(Zone.LIBRARY, playerA, "Island");
+        addCard(Zone.LIBRARY, playerA, "Mountain");
+        addCard(Zone.GRAVEYARD, playerA, "Grizzly Bears");
+        addCard(Zone.HAND, playerA, HYDRA);
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp", 3);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, HYDRA);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        assertGraveyardCount(playerA, "Island", 1);
+        assertGraveyardCount(playerA, "Mountain", 1);
+        assertLibraryCount(playerA, 0);
+        assertPermanentCount(playerA, "Villain Token", 0);
+    }
+
+    @Test
+    public void testHydraTroopersCreatesTappedMenaceTokenAtThreshold() {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        addCard(Zone.LIBRARY, playerA, "Lightning Bolt");
+        addCard(Zone.GRAVEYARD, playerA, "Grizzly Bears");
+        addCard(Zone.GRAVEYARD, playerA, "Silvercoat Lion");
+        addCard(Zone.HAND, playerA, HYDRA);
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp", 3);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, HYDRA);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        assertPermanentCount(playerA, "Villain Token", 1);
+        assertTapped("Villain Token", true);
+        assertPowerToughness(playerA, "Villain Token", 2, 1);
+        assertAbilityCount(playerA, "Villain Token", MenaceAbility.class, 1);
+        assertLibraryCount(playerA, "Lightning Bolt", 1);
+        assertGraveyardCount(playerA, "Lightning Bolt", 0);
+    }
+
+    @Test
+    public void testNickFuryPowerUpReductionEquipmentAndOncePerGame() {
+        addCard(Zone.BATTLEFIELD, playerA, NICK);
+        prepareNickMana();
+        prepareNickLibrary("Bonesplitter");
+
+        // On the turn Nick enters, his {W} mana cost reduces Power-up to
+        // {U}{B}{R}{G}; the untapped Plains is deliberately unnecessary.
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Power-up");
+        setChoice(playerA, "Bonesplitter");
+        // With all five colors untapped again, the same known ability prefix
+        // must still be unavailable because Power-up is once per game.
+        checkPlayableAbility(
+                "Power-up cannot be activated twice",
+                3, PhaseStep.PRECOMBAT_MAIN, playerA, "Power-up", false
+        );
+
+        setStrictChooseMode(true);
+        setStopAt(3, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        assertCounterCount(playerA, NICK, CounterType.P1P1, 2);
+        assertPowerToughness(playerA, NICK, 4, 3);
+        assertPermanentCount(playerA, "Bonesplitter", 1);
+        assertHandCount(playerA, "Lightning Bolt", 1);
+    }
+
+    @Test
+    public void testNickFuryMayDeclineAndPutsLookedCardsBelowEighthCard() {
+        addCard(Zone.BATTLEFIELD, playerA, NICK);
+        prepareNickMana();
+        prepareNickLibrary("Bonesplitter");
+
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Power-up");
+        setChoice(playerA, TestPlayer.CHOICE_SKIP);
+
+        setStrictChooseMode(true);
+        setStopAt(3, PhaseStep.PRECOMBAT_MAIN);
+        execute();
+
+        assertCounterCount(playerA, NICK, CounterType.P1P1, 2);
+        assertPermanentCount(playerA, "Bonesplitter", 0);
+        // The former eighth card is drawn before any of the seven cards that
+        // were put on the bottom in random order.
+        assertHandCount(playerA, "Lightning Bolt", 1);
+        assertLibraryCount(playerA, 7);
+    }
+
+    @Test
+    public void testNickFuryMayTransformChosenDoubleFacedHero() {
+        addCard(Zone.BATTLEFIELD, playerA, NICK);
+        prepareNickMana();
+        prepareNickLibrary("Peter Parker");
+
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Power-up");
+        setChoice(playerA, "Peter Parker");
+        setChoice(playerA, true);
+
+        setStrictChooseMode(true);
