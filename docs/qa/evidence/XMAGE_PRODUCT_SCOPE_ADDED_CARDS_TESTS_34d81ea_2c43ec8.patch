+    @Test
+    public void testOriginScryAndDeclinedChapterTwoDraw() {
+        prepareFourCardLibrary();
+        addCard(Zone.HAND, playerA, ORIGIN);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 2);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, ORIGIN);
+        addTarget(playerA, CARD_A); // Scry A to the bottom; B stays on top.
+        setChoice(playerA, false); // Decline chapter II and draw.
+
+        setStrictChooseMode(true);
+        setStopAt(3, PhaseStep.POSTCOMBAT_MAIN);
+        execute();
+
+        assertHandCount(playerA, CARD_B, 1); // Draw step.
+        assertHandCount(playerA, CARD_C, 1); // Chapter II fallback.
+        assertCounterCount(playerA, ORIGIN, CounterType.LORE, 2);
+        assertLibraryCount(playerA, 2);
+    }
+
+    @Test
+    public void testOriginFiltersChapterTwoAndCountersOnlyControlledCreatures() {
+        prepareFourCardLibrary();
+        addCard(Zone.HAND, playerA, ORIGIN);
+        addCard(Zone.HAND, playerA, NICK); // Eligible Hero, mana value 1.
+        addCard(Zone.HAND, playerA, "Wolverine, Claws Out"); // Hero, mana value 4.
+        addCard(Zone.HAND, playerA, "Centaur Courser"); // Mana value 3, not a Hero.
+        addCard(Zone.BATTLEFIELD, playerA, "Memnite");
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 2);
+        addCard(Zone.BATTLEFIELD, playerB, "Grizzly Bears");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, ORIGIN);
+        addTarget(playerA, CARD_A); // Keep the draw sequence deterministic.
+        setChoice(playerA, true);
+        setChoice(playerA, NICK);
+
+        setStrictChooseMode(true);
+        setStopAt(5, PhaseStep.POSTCOMBAT_MAIN);
+        execute();
+
+        assertPermanentCount(playerA, NICK, 1);
+        assertHandCount(playerA, "Wolverine, Claws Out", 1);
+        assertHandCount(playerA, "Centaur Courser", 1);
+        // No chapter-II fallback draw occurred: only the turn-three and
+        // turn-five draw-step cards join the two rejected cards in hand.
+        assertHandCount(playerA, 4);
+        assertCounterCount(playerA, NICK, CounterType.P1P1, 1);
+        assertCounterCount(playerA, "Memnite", CounterType.P1P1, 1);
+        assertCounterCount(playerB, "Grizzly Bears", CounterType.P1P1, 0);
+        assertPermanentCount(playerA, ORIGIN, 0);
+        assertGraveyardCount(playerA, ORIGIN, 1);
+    }
+
