+    @Test
+    public void testSpdrDrawsOncePerModifiedCreatureAndIgnoresUnmodified() {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+        addCard(Zone.LIBRARY, playerA, "Mountain");
+        addCard(Zone.LIBRARY, playerA, "Island");
+        addCard(Zone.BATTLEFIELD, playerA, SPDR);
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears");
+        addCard(Zone.BATTLEFIELD, playerA, "Silvercoat Lion");
+        addCard(Zone.BATTLEFIELD, playerA, "Pillarfield Ox");
+
+        addCounters(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Grizzly Bears", CounterType.P1P1, 1);
+        addCounters(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Silvercoat Lion", CounterType.P1P1, 1);
+        attack(1, playerA, "Grizzly Bears", playerB);
+        attack(1, playerA, "Silvercoat Lion", playerB);
+        attack(1, playerA, "Pillarfield Ox", playerB);
+        setChoice(playerA, "Whenever a modified creature you control deals combat damage");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.POSTCOMBAT_MAIN);
+        execute();
+
+        assertHandCount(playerA, 2);
+        assertLibraryCount(playerA, 0);
+        assertLife(playerB, 12);
+    }
