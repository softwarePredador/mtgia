+    }
+
+    @Test
+    public void testPhotonBlastXTwoMayKeepOriginalTargetForBothCopies() {
+        addCard(Zone.HAND, playerA, PHOTON);
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 4);
+        addCard(Zone.BATTLEFIELD, playerB, "Centaur Courser");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, PHOTON, "Centaur Courser");
+        setChoice(playerA, "X=2");
+        setChoice(playerA, false, 2);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        // Original plus two copies deal exactly the creature's 3 toughness.
+        assertPermanentCount(playerB, "Centaur Courser", 0);
+        assertGraveyardCount(playerB, "Centaur Courser", 1);
+    }
