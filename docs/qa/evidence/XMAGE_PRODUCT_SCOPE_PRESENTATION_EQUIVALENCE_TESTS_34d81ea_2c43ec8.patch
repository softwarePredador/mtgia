+
+    @Test
+    public void wolverineFightThenNewDamageHealsPreviouslyMarkedDamage() {
+        addCard(Zone.HAND, playerA, WOLVERINE);
+        addCard(Zone.HAND, playerA, "Lightning Bolt");
+        addCard(Zone.BATTLEFIELD, playerA, "Forest", 2);
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 4);
+        addCard(Zone.BATTLEFIELD, playerB, "Hill Giant");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, WOLVERINE);
+        addTarget(playerA, "Hill Giant");
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Lightning Bolt", WOLVERINE);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        assertGraveyardCount(playerB, "Hill Giant", 1);
+        assertPermanentCount(playerA, WOLVERINE, 1);
+        assertDamageReceived(playerA, WOLVERINE, 3);
+        assertAbility(playerA, WOLVERINE, HasteAbility.getInstance(), true);
+    }
+}
