{
  "schema_version": "manaloom_ui_live_evidence_policy_v1",
  "status_model": {
    "automated": "PASS_AUTOMATED",
    "runtime": "PASS_RUNTIME",
    "visual_review": "PASS_VISUAL_REVIEWED",
    "aggregate": "PASS",
    "aggregate_requires_all_levels": true
  },
  "source_digest": {
    "command": "../scripts/manaloom_ui_source_digest.sh",
    "scope": "all app-facing Flutter sources, assets, Web shell, Android resources, visual surface contract and live-proof harness",
    "stale_evidence_fails_closed": true
  },
  "gate": {
    "command": "../scripts/manaloom_ui_live_evidence_gate.sh --check",
    "capture_command": "MANALOOM_UI_PROOF_DEVICE=<ANDROID_DEVICE_ID> ../scripts/manaloom_ui_live_evidence_gate.sh --capture-battle-coach",
    "p0_index_command": "MANALOOM_P0_*_DIR=<REPO_CAPTURE_DIR> MANALOOM_P0_*_LOG=<RUNTIME_LOG> ../scripts/manaloom_ui_live_evidence_gate.sh --index-p0-matrix",
    "current_review": "../docs/qa/ui-live/latest.json",
    "reviewer_must_open_every_screenshot": true,
    "widget_or_golden_alone_can_pass_visual": false
  },
  "required_review_criteria": [
    "visual_hierarchy",
    "brand_and_mtg_identity",
    "color_and_contrast",
    "typography",
    "spacing_and_density",
    "responsive_fit",
    "interaction_clarity",
    "state_coverage",
    "accessibility_visual",
    "attractiveness"
  ],
  "surfaces": [
    {
      "id": "battle_coach",
      "route": "/decks/:id/battle-coach[/sessionId]",
      "source": "lib/features/battle/screens/battle_coach_screen.dart",
      "automated_test": "test/features/battle/screens/battle_coach_screen_test.dart",
      "runtime_test": "integration_test/battle_coach_visual_runtime_proof_test.dart",
      "stable_keys": [
        "battle-coach-welcome-state",
        "battle-coach-board",
        "battle-coach-own-hand",
        "battle-coach-error-banner",
        "battle-coach-action-progress",
        "battle-coach-terminal-panel"
      ],
      "required_checkpoints": [
        "battle_coach_00_welcome",
        "battle_coach_01_active_table",
        "battle_coach_02_decision_prompt",
        "battle_coach_03_recoverable_error",
        "battle_coach_04_concede_confirmation",
        "battle_coach_05_action_progress",
        "battle_coach_06_terminal_replay"
      ]
    },
    {
      "id": "authenticated_p0_matrix",
      "route": "all active P0 routes declared by ui_surface_inventory.json",
      "source": "integration_test/app_existing_user_visual_audit_test.dart",
      "automated_test": "test/ui/ui_authenticated_visual_matrix_test.dart",
      "runtime_test": "integration_test/app_existing_user_visual_audit_test.dart",
      "stable_keys": [
        "login-email-field",
        "register-legal-acceptance",
        "legal-terms-section",
        "legal-privacy-section",
        "home-hero-frame",
        "deck-list-empty-state",
        "deck-overview-hero",
        "battle-coach-welcome-state",
        "profile-content"
      ],
      "required_profiles": {
        "web_mobile_390x844": 54,
        "web_desktop_1440x900": 53,
        "web_wide_1920x1080": 53,
        "android_physical_sm_a135m": 54
      },
      "required_checkpoints": [
        "splash_boot",
        "login_empty",
        "register_empty",
        "register_consent_unchecked",
        "register_consent_error",
        "register_consent_accepted",
        "forgot_password_empty",
        "reset_password_invalid_link",
        "verify_email_signed_out",
        "legal_terms",
        "legal_privacy",
        "home_top",
        "home_quick_actions_scrolled",
        "onboarding_core_flow",
        "life_counter_initial",
        "decks_empty",
        "decks_seeded",
        "deck_create_modal",
        "deck_detail_top",
        "deck_detail_below_fold",
        "card_search_empty",
        "card_search_results",
        "post_game_empty",
        "deck_generate_empty",
        "deck_import_detected",
        "collection_empty",
        "sets_catalog",
        "sets_catalog_route",
        "latest_set",
        "set_detail_tst",
        "card_detail_success",
        "card_detail_error",
        "community_empty",
        "community_tab_1",
        "community_tab_2",
        "community_tab_3",
        "user_search_empty",
        "user_search_results",
        "user_profile_success",
        "community_deck_success",
        "profile_success",
        "battle_replays_empty",
        "battle_coach_welcome",
        "battle_live_disabled",
        "messages_inbox",
        "chat_unavailable",
        "notifications",
        "trades_inbox",
        "trade_create",
        "trade_detail_unavailable",
        "plans_success",
        "upgrade_success",
        "checkout_success",
        "legal_success"
      ]
    }
  ],
  "release_accessibility": {
    "android_talkback": "pending_physical_human_review",
    "agent_visual_review_does_not_replace_screen_reader": true,
    "ios_voiceover": "DEFERRED_BY_SCOPE"
  }
}
