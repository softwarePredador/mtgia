{
  "schema_version": "manaloom_ui_live_evidence_policy_v1",
  "status_model": {
    "automated": "PASS_AUTOMATED",
    "runtime": "PASS_RUNTIME",
    "visual_review": "PASS_VISUAL_REVIEWED",
    "aggregate": "PASS",
    "aggregate_requires_all_levels": true
  },
  "source_digest": {
    "command": "../scripts/manaloom_ui_source_digest.sh",
    "scope": "all app-facing Flutter sources, assets, Web shell, Android resources, visual surface contract and live-proof harness",
    "stale_evidence_fails_closed": true
  },
  "gate": {
    "command": "../scripts/manaloom_ui_live_evidence_gate.sh --check",
    "capture_command": "MANALOOM_UI_PROOF_DEVICE=<ANDROID_RUNTIME_ID> MANALOOM_UI_ANDROID_RUNTIME_KIND=auto ../scripts/manaloom_ui_live_evidence_gate.sh --capture-battle-coach",
    "battle_live_capture_command": "../scripts/manaloom_ui_live_evidence_gate.sh --capture-battle-live-web",
    "binder_import_capture_command": "../scripts/manaloom_binder_import_visual_qa.sh",
    "deck_workshop_capture_command": "../scripts/manaloom_deck_workshop_visual_qa.sh",
    "battle_learning_capture_command": "../scripts/manaloom_battle_learning_visual_qa.sh",
    "social_trade_capture_command": "../scripts/manaloom_social_trade_visual_qa.sh",
    "onboarding_intent_capture_command": "../scripts/manaloom_onboarding_intent_visual_qa.sh",
    "visual_system_workspace_capture_command": "../scripts/manaloom_visual_system_workspace_qa.sh",
    "critical_overlays_states_capture_command": "../scripts/manaloom_critical_overlays_states_visual_qa.sh",
    "p0_capture_command": "../scripts/manaloom_p0_runtime_capture.sh --profile <PROFILE> --ready-manifest <READY_JSON> --runtime-log <LOG> [--device <ANDROID_RUNTIME_ID>]",
    "p0_index_command": "MANALOOM_P0_*_DIR=<REPO_CAPTURE_DIR> MANALOOM_P0_*_LOG=<RUNTIME_LOG> ../scripts/manaloom_ui_live_evidence_gate.sh --index-p0-matrix",
    "current_review": "../docs/qa/ui-live/latest.json",
    "reviewer_must_open_every_screenshot": true,
    "widget_or_golden_alone_can_pass_visual": false,
    "web_host_margin_crop": {
      "driver": "test_driver/integration_test.dart",
      "strategy": "crop_only_symmetric_near_white_host_margins",
      "keeps_full_surface_when_uncertain": true,
      "runtime_log_marker": "SCREENSHOT_VIEWPORT_CROP"
    }
  },
  "required_review_criteria": [
    "visual_hierarchy",
    "brand_and_mtg_identity",
    "color_and_contrast",
    "typography",
    "spacing_and_density",
    "responsive_fit",
    "interaction_clarity",
    "state_coverage",
    "accessibility_visual",
    "attractiveness"
  ],
